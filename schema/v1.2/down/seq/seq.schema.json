{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socket-ctrl.github.io/cbm-mqtt-schemas/schema/v1.2/down/seq/seq.schema.json",
  "title": "连锁指令下发",
  "description": "平台→网关用户自定义连锁指令（协议 5.1.3，平台编排好每个步骤依次下发）。Topic: /cbm/down/{gw_id}/{wf_id}/{well_id}/seq。seq 为增强型连锁控制通道，动作词汇与 ctrl 单指令通道不要求一一对应，由网关侧解析执行。动作枚举：start(启动，parameters.value=启动速度)、stop(停机，无参数)、wait(等待，parameters.time=等待时间，秒；step_timeout 建议=等待时间×1.1+5 秒)、set(设定，parameters.value=目标值，区分正负：正值为正转转速、负值为反转转速)、accel(调速，parameters.value=增量值，区分正负：负值为减)、set_valve(设定放气阀门开度，parameters.value=目标开度，0-100%)、start_reinject(回注水泵启动，仅限电潜泵，parameters.value=启动速度)、stop_reinject(回注水泵停止，仅限电潜泵，无参数)、set_reinject(设定回注水泵转速，仅限电潜泵，parameters.value=目标转速，rpm)。连锁指令失败或超时立即停止，后续步骤不执行，平台不重发连锁指令。",
  "type": "object",
  "additionalProperties": false,
  "required": ["header", "cmd"],
  "properties": {
    "header": {
      "$ref": "../../common/header.schema.json"
    },
    "cmd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd_id", "parameters"],
      "properties": {
        "cmd_id": {
          "type": "string",
          "description": "指令唯一标识，网关在 seq_ack 与 seq_res 中原样回显",
          "examples": ["CMD20240115005"]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["steps"],
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 1,
              "description": "连锁步骤序列，按序执行",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["action", "parameters", "step_timeout"],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": ["start", "stop", "wait", "set", "accel", "set_valve", "start_reinject", "stop_reinject", "set_reinject"],
                    "description": "步骤动作：start(启动) / stop(停机) / wait(等待) / set(设定) / accel(调速) / set_valve(设定放气阀门开度) / start_reinject(回注水泵启动，仅电潜泵) / stop_reinject(回注水泵停止，仅电潜泵) / set_reinject(设定回注水泵转速，仅电潜泵)"
                  },
                  "parameters": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "value": {
                        "type": "number",
                        "description": "动作参数：启动速度 / 目标值（区分正负，正值为正转转速、负值为反转转速） / 增量值（区分正负，当前值+增量值） / 阀门开度 0-100% / 回注水泵目标转速 rpm，含义见各动作说明"
                      },
                      "time": {
                        "type": "number",
                        "description": "wait 动作的等待时间，秒"
                      }
                    }
                  },
                  "step_timeout": {
                    "type": "number",
                    "description": "该步骤执行超时时间，秒；wait 动作建议为 等待时间×1.1+5 秒"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "action": {
                          "enum": ["start", "set", "accel", "set_valve", "start_reinject", "set_reinject"]
                        }
                      },
                      "required": ["action"]
                    },
                    "then": {
                      "properties": {
                        "parameters": {
                          "required": ["value"]
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "action": {
                          "const": "wait"
                        }
                      },
                      "required": ["action"]
                    },
                    "then": {
                      "properties": {
                        "parameters": {
                          "required": ["time"]
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "action": {
                          "const": "set_valve"
                        }
                      },
                      "required": ["action"]
                    },
                    "then": {
                      "properties": {
                        "parameters": {
                          "properties": {
                            "value": {
                              "minimum": 0,
                              "maximum": 100
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
