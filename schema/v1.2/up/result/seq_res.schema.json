{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbm.example/schemas/v1.2/up/result/seq_res.schema.json",
  "title": "连锁指令步骤执行结果",
  "description": "网关→平台连锁指令执行结果（协议 5.3.2）。Topic: /cbm/up/{gw_id}/{wf_id}/{well_id}/result/seq_res。每个步骤执行后上报一条；步骤总数由平台侧编排管理，平台依据 cmd_id 关联步骤序列，网关无需上报总步骤数。连锁指令失败或超时立即停止，后续步骤不执行，平台不重发连锁指令。",
  "type": "object",
  "additionalProperties": false,
  "required": ["header", "step_result"],
  "properties": {
    "header": {
      "$ref": "../../common/header.schema.json"
    },
    "step_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd_id", "step_index", "fail_reason", "step_status", "start_timestamp", "end_timestamp", "step_time", "total_time"],
      "properties": {
        "cmd_id": {
          "type": "string",
          "description": "对应的下行连锁指令 ID，原样回显 seq 下行报文 cmd 节点中的 cmd_id"
        },
        "step_index": {
          "type": "integer",
          "minimum": 1,
          "description": "当前步骤索引，从 1 开始"
        },
        "fail_reason": {
          "type": ["string", "null"],
          "description": "执行失败原因，成功为 null"
        },
        "step_status": {
          "type": "string",
          "enum": ["success", "failed", "timeout", "running"],
          "description": "步骤执行状态：success(执行成功) / failed(执行失败) / timeout(执行超时) / running(执行中)"
        },
        "start_timestamp": {
          "$ref": "../../common/defs.schema.json#/$defs/unix_ms",
          "description": "该步骤开始执行时间戳，UNIX 毫秒（13 位数字字符串）"
        },
        "end_timestamp": {
          "$ref": "../../common/defs.schema.json#/$defs/unix_ms",
          "description": "该步骤结束执行时间戳，UNIX 毫秒（13 位数字字符串）"
        },
        "step_time": {
          "type": "number",
          "minimum": 0,
          "description": "该步骤执行耗时，秒"
        },
        "total_time": {
          "type": "number",
          "minimum": 0,
          "description": "总执行耗时，秒"
        }
      }
    }
  }
}
