{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbm.example/schemas/v1.2/up/prod/esp.schema.json",
  "title": "电潜泵生产数据上报",
  "description": "网关→平台生产数据（协议 4.1.2，电潜泵井场井下电潜泵）。Topic: /cbm/up/{gw_id}/{wf_id}/{well_id}/prod/esp。speed（泵实际转速）与 freq（电机工作频率）为两个独立测量量；以 _setpoint 结尾的字段为底层设备当前生效设定值的回显。",
  "type": "object",
  "additionalProperties": false,
  "required": ["header", "data"],
  "properties": {
    "header": {
      "$ref": "../../common/header.schema.json"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_type", "status", "run_status", "ctrl_mode", "prod_period",
        "speed", "speed_setpoint", "freq",
        "A_current", "B_current", "C_current",
        "A_voltage", "B_voltage", "C_voltage",
        "busbar_voltage", "motor_power", "runtime_hours",
        "fault_code", "fault_description"
      ],
      "properties": {
        "device_type": {
          "type": "string",
          "const": "esp",
          "description": "设备类型：esp(电潜泵)"
        },
        "status": {
          "$ref": "../../common/defs.schema.json#/$defs/status"
        },
        "run_status": {
          "$ref": "../../common/defs.schema.json#/$defs/run_status"
        },
        "ctrl_mode": {
          "$ref": "../../common/defs.schema.json#/$defs/ctrl_mode"
        },
        "prod_period": {
          "$ref": "../../common/defs.schema.json#/$defs/prod_period"
        },
        "speed": {
          "type": "number",
          "description": "泵实际转速，rpm（独立测量量）"
        },
        "speed_setpoint": {
          "type": "number",
          "description": "转速设定值，rpm（设备回显）"
        },
        "freq": {
          "type": "number",
          "description": "电机工作频率，Hz（独立测量量）"
        },
        "A_current": {
          "type": "number",
          "description": "A相电流，A"
        },
        "B_current": {
          "type": "number",
          "description": "B相电流，A"
        },
        "C_current": {
          "type": "number",
          "description": "C相电流，A"
        },
        "A_voltage": {
          "type": "number",
          "description": "A相电压，V"
        },
        "B_voltage": {
          "type": "number",
          "description": "B相电压，V"
        },
        "C_voltage": {
          "type": "number",
          "description": "C相电压，V"
        },
        "busbar_voltage": {
          "type": "number",
          "description": "母线电压，V"
        },
        "motor_power": {
          "type": "number",
          "description": "电机功率，kW"
        },
        "runtime_hours": {
          "type": "number",
          "minimum": 0,
          "description": "累计运行时间，小时"
        },
        "fault_code": {
          "$ref": "../../common/defs.schema.json#/$defs/fault_code"
        },
        "fault_description": {
          "$ref": "../../common/defs.schema.json#/$defs/fault_description"
        }
      }
    }
  }
}
