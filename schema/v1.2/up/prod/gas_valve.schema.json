{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbm.example/schemas/v1.2/up/prod/gas_valve.schema.json",
  "title": "放气阀生产数据上报",
  "description": "网关→平台生产数据（协议 4.4.4.1，放气阀/气体）。Topic: /cbm/up/{gw_id}/{wf_id}/{well_id}/prod/gas_valve。valve_sp 为设备当前生效开度设定值回显；full_open/full_close 为到位开关量信号（1=到位，0=未到位）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["header", "data"],
  "properties": {
    "header": {
      "$ref": "../../common/header.schema.json"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_type", "status", "valve_fb", "valve_sp", "full_open", "full_close"],
      "properties": {
        "device_type": {
          "type": "string",
          "const": "gas_valve",
          "description": "设备类型：gas_valve(放气阀)"
        },
        "status": {
          "$ref": "../../common/defs.schema.json#/$defs/status"
        },
        "valve_fb": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "放气阀开度反馈，0-100%"
        },
        "valve_sp": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "放气阀开度设定值，0-100%（设备回显）"
        },
        "full_open": {
          "type": "integer",
          "enum": [0, 1],
          "description": "放气阀门开到位：1(开到位) / 0(未开到位)"
        },
        "full_close": {
          "type": "integer",
          "enum": [0, 1],
          "description": "放气阀门关到位：1(关到位) / 0(未关到位)"
        }
      }
    }
  }
}
